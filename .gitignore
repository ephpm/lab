# Local upstream checkouts used while reproducing the lab.
# The public repo records exact commits and patches instead of vendoring clones.
apps/

# Generated manifests and temporary files.
.generated/
tmp/
*.tmp

# Raw oha output from the podman database suites (DB-BENCH.md). Kept
# locally so a summary-script filtering bug can never silently discard a
# measurement, but far too large and too host-specific to commit. The
# tables in DB-BENCH.md and docs/ephpm-0.6.0-db-matrix.md are the record.
db/results-*/

# Local Kubernetes access and credentials.
kubeconfig*
*.kubeconfig
config.yaml
.kube/

# Environment files may contain app keys, DB credentials, or local endpoints.
.env
.env.*
!.env.example

# OS/editor noise.
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Dependency/build outputs.
vendor/
node_modules/
target/
dist/
build/

